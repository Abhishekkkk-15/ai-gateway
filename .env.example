# ==============================================================================
# OpenAI-Compatible Self-Hosted AI Gateway Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0

# Neon Serverless Postgres Connection String
# e.g., postgresql://neondb_owner:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb?sslmode=require

# Security Keys (Generate strong 32+ char random strings)
# MASTER_SECRET is used to derive the AES-256-GCM key that encrypts upstream provider API keys at rest.
MASTER_SECRET=generate-a-strong-32-byte-master-secret-key-here!

# JWT_SECRET is used to sign single-admin HttpOnly session cookies.
JWT_SECRET=generate-a-strong-32-byte-jwt-secret-key-here!

# Single-Admin Credentials
ADMIN_USERNAME=admin
# Use ADMIN_PASSWORD for instant initial boot, or generate ADMIN_PASSWORD_HASH
ADMIN_PASSWORD=admin-gateway-secret-password-change-me

# CORS Allowed Origins
# Comma-separated list of origins allowed to access the gateway (e.g., https://your-domain.com,http://localhost:5173)
# Set to * to allow all origins.
ALLOWED_ORIGINS=*
